# Used only for local `supabase functions serve --env-file supabase/functions/.env`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform when deployed — don't set them as secrets there.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — set these for real via `supabase secrets set` before deploying (§6).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_TEACHER=price_...
STRIPE_PRICE_CHOIR=price_...

APP_URL=http://localhost:8080
