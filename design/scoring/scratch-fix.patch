+/* ---------------- Scoring batch (scratch, never merged): onsets and level shape ---------------- */
+// A note's timing comes from an onset heard in its window, not from a voice being present. An onset is a rise of
+// ONSET_RISE_DB within ONSET_LOOKBACK_MS to above the voicing threshold (an entrance, or a re-articulation), or a pitch
+// arriving on the note (within 100 ct, none in the last ONSET_PITCH_AWAY_MS: a legato change of note); either is kept
+// only if the next 150 ms hold 3 frames on the note (±300 ct), so a click or a noise burst isn't one. The first onset
+// in [start − ONSET_EARLY_MS, start + 40 % of the note] is the note's; timing = timingAccuracy(onset − start), the
+// Rhythm and Entrance trainers' formula. No onset: 0.
+const ONSET_RISE_DB = 9, ONSET_LOOKBACK_MS = 120, ONSET_GAP_MS = 150, ONSET_PITCH_AWAY_MS = 150, ONSET_EARLY_MS = 150;
+function edgeAgoAbove(buf, sampleRate, thr){
+  const HOP = 64, hops = Math.floor(buf.length/HOP);
+  const loud = k=>{ let s=0; for(let i=k*HOP;i<(k+1)*HOP;i++) s+=buf[i]*buf[i]; return Math.sqrt(s/HOP) > thr; };
+  let k = hops-1; while(k>=0 && loud(k)) k--;
+  return (buf.length - (k+1)*HOP)/sampleRate;
+}
+function makeOnsetTracker(){
+  const hist = [], onsets = []; let lastOnset = -Infinity, lastNear = -Infinity, cand = null;
+  function push(t, raw, freq, target){
+    const rms = computeRMS(raw), db = 20*Math.log10(Math.max(rms, 1e-7));
+    hist.push({t, db}); while(hist.length && t-hist[0].t > ONSET_LOOKBACK_MS) hist.shift();
+    let minDb = Infinity; for(const x of hist) if(x.db<minDb) minDb = x.db;
+    const cents = freq>0 ? centsFromTarget(freq, target) : null;
+    const near = cents!==null && Math.abs(cents)<100, onNote = cents!==null && Math.abs(cents)<300;
+    if(!cand && t-lastOnset >= ONSET_GAP_MS){
+      if(rms>ONSET_RMS_THRESHOLD && db-minDb >= ONSET_RISE_DB){
+        const thr = Math.max(ONSET_RMS_THRESHOLD*0.5, Math.pow(10, (minDb+ONSET_RISE_DB/2)/20));
+        cand = {t: t - edgeAgoAbove(raw, audioCtx.sampleRate, thr)*1000, on:0, kind:'level'};
+      } else if(near && t-lastNear > ONSET_PITCH_AWAY_MS){ cand = {t, on:0, kind:'pitch'}; }
+    }
+    if(near) lastNear = t;
+    if(cand){
+      if(onNote) cand.on++;
+      if(cand.on>=3){ onsets.push(cand.t); lastOnset = cand.t; cand = null; }
+      else if(t-cand.t > 150) cand = null;
+    }
+  }
+  return {push, onsets};
+}
+function onsetTimings(onsets, n, D){
+  return Array.from({length:n}, (_,j)=>{
+    const s = j*D, o = onsets.find(x=>x>=s-ONSET_EARLY_MS && x<=s+D*0.4);
+    return o===undefined ? {offsetMs:null, score:0} : {offsetMs:Math.round(o-s), score:timingAccuracy(o-s)};
+  });
+}
+// Dynamics (Performance Director) and Expression (Emotional Singing): how much the sung level moves from note to note.
+// Per note, the frames of the voice (pitched, within 15 dB of the note's peak); the onset ramp (its first 150 ms) and
+// the release (its last 100 ms) left out; the room (the median power of the note's other frames) taken off the power;
+// the note's level = the median of what's left, in dB. Score from the spread of the note levels (sd, dB): a steady
+// level (sd ≤ 1 dB, a real held note's own wander) 0, a 4 dB sd (about a 12 dB phrase) 100. Under 3 notes: none.
+function levelShape(frames){
+  const byNote = {}; frames.forEach(f=>{ (byNote[f.idx] = byNote[f.idx] || []).push(f); });
+  const levels = [];
+  for(const k of Object.keys(byNote).sort((a,b)=>a-b)){
+    const fs = byNote[k], r = fs.map(f=>f.rms).sort((a,b)=>a-b), peak = r[Math.floor(r.length*0.95)] || 0;
+    if(peak<=0.012) continue;
+    const isV = f=>f.freq>0 && f.rms>=Math.max(0.012, peak*0.18);
+    const v = fs.filter(isV); if(v.length<8) continue;
+    const a = v[0].t+150, b = v[v.length-1].t-100, sus = v.filter(f=>f.t>=a && f.t<=b);
+    if(sus.length<8) continue;
+    const other = fs.filter(f=>!isV(f)).map(f=>f.rms*f.rms).sort((x,y)=>x-y), room = other.length>=5 ? other[other.length>>1] : 0;
+    const p = sus.map(f=>f.rms*f.rms).sort((x,y)=>x-y), med = p[p.length>>1];
+    levels.push(+(10*Math.log10(Math.max(med-room, med*0.1))).toFixed(2));
+  }
+  if(levels.length<3) return {score:null, levels, sd:null};
+  const m = levels.reduce((a,b)=>a+b,0)/levels.length, sd = Math.sqrt(levels.reduce((a,b)=>a+(b-m)*(b-m),0)/levels.length);
+  return {score: Math.max(0, Math.min(100, Math.round((2*sd-2)/6*100))), levels, sd:+sd.toFixed(2)};
+}
